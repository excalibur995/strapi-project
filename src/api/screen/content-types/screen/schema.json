{
  "kind": "collectionType",
  "collectionName": "screens",
  "info": {
    "singularName": "screen",
    "pluralName": "screens",
    "displayName": "Screen",
    "description": "A single SDUI screen config composed of three dynamic-zone slots: header, body, footer."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "screenId": {
      "type": "uid",
      "required": true
    },
    "screenKey": {
      "type": "string",
      "required": true
    },
    "meta": {
      "type": "component",
      "component": "sdui.screen-meta",
      "required": true
    },
    "header": {
      "type": "dynamiczone",
      "components": [
        "ui.progress-bar",
        "ui.text",
        "ui.image-preview",
        "ui.hero",
        "ui.banner",
        "ui.section-label",
        "ui.tab-group",
        "ui.subtitle-label-section"
      ]
    },
    "body": {
      "type": "dynamiczone",
      "components": [
        "ui.section-label",
        "ui.row",
        "ui.text",
        "ui.icon-text",
        "ui.banner",
        "ui.hero",
        "ui.radio-group",
        "ui.radio-group-async",
        "ui.checkbox-list",
        "ui.checkbox-list-async",
        "ui.checkbox",
        "ui.text-input",
        "ui.date-input",
        "ui.dropdown",
        "ui.dropdown-async",
        "ui.cascading-select",
        "ui.account-selector",
        "ui.money-input",
        "ui.camera-capture",
        "ui.image-preview",
        "ui.item-list",
        "ui.review-card",
        "ui.card",
        "ui.money-display",
        "ui.badge",
        "ui.tab-group",
        "ui.passcode-input",
        "ui.local-state",
        "ui.rich-text",
        "ui.link",
        "ui.divider"
      ]
    },
    "footer": {
      "type": "dynamiczone",
      "components": [
        "ui.slide-to-confirm",
        "ui.button",
        "ui.banner",
        "ui.divider"
      ]
    },
    "version": {
      "type": "decimal",
      "required": true,
      "default": 1
    }
  }
}
