{
  "kind": "collectionType",
  "collectionName": "screens",
  "info": {
    "singularName": "screen",
    "pluralName": "screens",
    "displayName": "Screen",
    "description": "A single SDUI screen config composed of three dynamic-zone slots: header, body, footer."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "screenId": {
      "type": "uid",
      "required": true
    },
    "screenKey": {
      "type": "string",
      "required": true
    },
    "meta": {
      "type": "component",
      "component": "sdui.screen-meta",
      "required": true
    },
    "header": {
      "type": "dynamiczone",
      "components": [
        "ui.progress-bar",
        "ui.text",
        "ui.image-preview",
        "ui.banner",
        "ui.tab-group"
      ]
    },
    "body": {
      "type": "dynamiczone",
      "components": [
        "ui.text",
        "ui.banner",
        "ui.radio-group",
        "ui.checkbox",
        "ui.text-input",
        "ui.date-input",
        "ui.dropdown",
        "ui.dropdown-async",
        "ui.money-input",
        "ui.camera-capture",
        "ui.image-preview",
        "ui.item-list",
        "ui.money-display",
        "ui.tab-group",
        "ui.passcode-input",
        "ui.rich-text",
        "ui.link",
        "ui.divider"
      ]
    },
    "footer": {
      "type": "dynamiczone",
      "components": [
        "ui.slide-to-confirm",
        "ui.button",
        "ui.banner",
        "ui.divider"
      ]
    },
    "version": {
      "type": "decimal",
      "required": true,
      "default": 1
    },
    "subscreens": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::screen.screen"
    },
    "isHeaderNullInstead": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    },
    "isFooterNullInstead": {
      "type": "boolean",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": false
    }
  }
}
