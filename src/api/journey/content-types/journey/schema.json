{
  "kind": "collectionType",
  "collectionName": "journeys",
  "info": {
    "singularName": "journey",
    "pluralName": "journeys",
    "displayName": "Journey",
    "description": "A named multi-step flow. Supports USER screens and SYSTEM operations with success/failure branching."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "required": true,
      "targetField": "name"
    },
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "description": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },

    "schemaVersion": {
      "type": "string",
      "required": true,
      "default": "1.0"
    },
    "bundleVersion": {
      "type": "string",
      "required": false
    },

    "productType": {
      "type": "enumeration",
      "enum": ["CARDS", "LOANS", "DEPOSITS", "ACCOUNTS", "TRANSFERS", "INVESTMENTS", "INSURANCE", "OTHER"]
    },
    "segment": {
      "type": "enumeration",
      "enum": ["ETB", "NTB", "ALL"],
      "default": "ALL"
    },
    "owner": {
      "type": "string"
    },

    "idempotencyRequired": {
      "type": "boolean",
      "default": false
    },
    "checkpointEnabled": {
      "type": "boolean",
      "default": false
    },
    "maxRetry": {
      "type": "integer",
      "default": 3
    },
    "async": {
      "type": "boolean",
      "default": false
    },

    "steps": {
      "type": "dynamiczone",
      "components": ["sdui.step-user", "sdui.step-system"],
      "required": true
    },

    "initialState": {
      "type": "json"
    },
    "onExit": {
      "type": "component",
      "component": "sdui.action"
    },
    "analytics": {
      "type": "json"
    }
  }
}
