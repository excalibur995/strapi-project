{
  "kind": "collectionType",
  "collectionName": "journeys",
  "info": {
    "singularName": "journey",
    "pluralName": "journeys",
    "displayName": "Journey",
    "description": "A named multi-screen flow. Defines ordered screens, versioning, metadata, and policies."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "journeyId": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "description": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "schemaVersion": {
      "type": "string",
      "default": "1.0",
      "required": true
    },
    "bundleVersion": {
      "type": "string",
      "required": false
    },
    "productType": {
      "type": "enumeration",
      "enum": [
        "CARDS",
        "LOANS",
        "DEPOSITS",
        "ACCOUNTS",
        "TRANSFERS",
        "INVESTMENTS",
        "INSURANCE",
        "OTHER"
      ]
    },
    "segment": {
      "type": "enumeration",
      "default": "ALL",
      "enum": [
        "ETB",
        "NTB",
        "ALL"
      ]
    },
    "owner": {
      "type": "string"
    },
    "idempotencyRequired": {
      "type": "boolean",
      "default": false
    },
    "checkpointEnabled": {
      "type": "boolean",
      "default": false
    },
    "maxRetry": {
      "type": "integer",
      "default": 3
    },
    "async": {
      "type": "boolean",
      "default": false
    },
    "screens": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::screen.screen"
    },
    "initialState": {
      "type": "json"
    },
    "onExit": {
      "type": "component",
      "component": "sdui.action"
    },
    "analytics": {
      "type": "json"
    },
    "presentation": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "card",
      "enum": [
        "card",
        "modal",
        "transparentModal",
        "containedModal",
        "containedTransparentModal",
        "fullScreenModal",
        "formSheet"
      ]
    }
  }
}
