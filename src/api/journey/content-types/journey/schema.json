{
  "kind": "collectionType",
  "collectionName": "journeys",
  "info": {
    "singularName": "journey",
    "pluralName": "journeys",
    "displayName": "Journey",
    "description": "A named multi-screen flow. Defines ordered screens, versioning, metadata, and policies."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "journeyId": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "name": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "description": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "segment": {
      "type": "enumeration",
      "default": "ALL",
      "enum": [
        "ETB",
        "NTB",
        "ALL"
      ]
    },
    "checkpointEnabled": {
      "type": "boolean",
      "default": false
    },
    "screens": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::screen.screen"
    },
    "initialState": {
      "type": "json"
    },
    "analytics": {
      "type": "json"
    },
    "presentation": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "card",
      "enum": [
        "card",
        "modal",
        "transparentModal",
        "containedModal",
        "containedTransparentModal",
        "fullScreenModal",
        "formSheet"
      ]
    },
    "steps": {
      "type": "component",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "component": "sdui.steps",
      "repeatable": true
    },
    "navigator": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "enum": [
        "CurrentAccountJourneyNavigator",
        "ETBOnboardCCRegisterJourney"
      ]
    },
    "preInitiateScreen": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "api_version": {
      "type": "string",
      "default": "v1",
      "required": true
    },
    "content_version": {
      "type": "integer",
      "required": true,
      "default": 1
    }
  }
}
