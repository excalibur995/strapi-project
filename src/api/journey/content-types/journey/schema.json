{
  "kind": "collectionType",
  "collectionName": "journeys",
  "info": {
    "singularName": "journey",
    "pluralName": "journeys",
    "displayName": "Journey",
    "description": "A named multi-screen flow. Defines ordered screens, versioning, metadata, and policies."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "flowId": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "screens": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::screen.screen"
    },
    "initialState": {
      "type": "json"
    },
    "presentation": {
      "type": "enumeration",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "default": "card",
      "enum": [
        "card",
        "modal",
        "transparentModal",
        "containedModal",
        "containedTransparentModal",
        "fullScreenModal",
        "formSheet"
      ]
    },
    "preInitiateScreen": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "version": {
      "type": "decimal",
      "required": true,
      "default": 1
    },
    "navigator": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
