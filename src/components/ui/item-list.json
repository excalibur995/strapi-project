{
  "collectionName": "components_ui_item_lists",
  "info": {
    "displayName": "Item List",
    "description": "Generic tappable list with optional tab filtering. type: ui.item-list"
  },
  "options": {},
  "attributes": {
    "componentId": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "testId": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "name": { "type": "string" },
    "defaultValue": { "type": "string" },
    "maxLength": { "type": "string" },
    "required": { "type": "boolean", "default": false },
    "enabled": { "type": "boolean", "default": true },
    "editable": { "type": "boolean", "default": true },
    "prefix": { "type": "string" },
    "suffix": { "type": "string" },
    "toggleField": { "type": "boolean", "default": false },
    "toggleFieldReff": { "type": "string" },
    "toggleFieldCollapse": { "type": "boolean", "default": false },
    "collapsable": { "type": "boolean", "default": false },
    "collapseCondition": { "type": "string" },
    "filterBy": { "type": "string" },
    "scope": { "type": "enumeration", "enum": ["journeyState", "localState", "serverState"], "default": "journeyState" },
    "visibility": { "type": "component", "component": "sdui.visibility" },
    "validations": {
      "type": "component",
      "component": "sdui.validation",
      "repeatable": true
    },
    "span": {
      "type": "integer"
    },
    "options": {
      "type": "component",
      "component": "ui.option",
      "repeatable": true
    },
    "dynamic": {
      "type": "component",
      "component": "sdui.dynamic"
    }
  }
}
