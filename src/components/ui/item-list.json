{
  "collectionName": "components_ui_item_lists",
  "info": {
    "displayName": "Item List",
    "description": "Generic tappable list with optional tab filtering. type: ui.item-list"
  },
  "options": {},
  "attributes": {
    "key": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "testId": { "type": "string" },
    "label": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "filterBy": {
      "type": "component",
      "component": "sdui.binding"
    },
    "options": {
      "type": "component",
      "component": "ui.list-item",
      "repeatable": true,
      "required": true
    },
    "span": {
      "type": "integer"
    }
  }
}
