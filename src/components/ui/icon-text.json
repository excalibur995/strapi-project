{
  "collectionName": "components_ui_icon_texts",
  "info": {
    "displayName": "Icon Text",
    "description": "A row displaying an icon alongside text. type: ui.icon-text"
  },
  "options": {},
  "attributes": {
    "componentId": { "type": "string" },
    "testId": { "type": "string" },
    "label": {
      "type": "text",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "visibility": {
      "type": "component",
      "component": "sdui.visibility"
    },
    "binding": { "type": "component", "component": "sdui.binding" },
    "validations": { "type": "component", "component": "sdui.validation", "repeatable": true },
    "span": {
      "type": "integer"
    },
    "dynamic": { "type": "component", "component": "sdui.dynamic" }
  }
}
