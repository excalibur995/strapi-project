{
  "collectionName": "components_ui_list_items",
  "info": { "displayName": "List Item", "description": "Single row inside ui.item-list" },
  "options": {},
  "attributes": {
    "key": { "type": "string", "required": true },
    "label": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "description": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "icon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images", "files", "videos", "audios"]
    },
    "tab": { "type": "string" },
    "onTap": { "type": "component", "component": "sdui.action", "required": true },
    "visibility": { "type": "component", "component": "sdui.visibility" },
    "rowGroup": { "type": "string", "required": false }
  }
}
