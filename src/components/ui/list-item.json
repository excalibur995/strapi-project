{
  "collectionName": "components_ui_list_items",
  "info": {
    "displayName": "List Item",
    "description": "Single row inside ui.item-list"
  },
  "options": {},
  "attributes": {
    "key": {
      "type": "string",
      "required": true
    },
    "testId": { "type": "string" },
    "label": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "description": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "tab": {
      "type": "string"
    },
    "onTap": {
      "type": "component",
      "component": "sdui.action",
      "repeatable": false,
      "required": false
    },
    "visibility": {
      "type": "component",
      "component": "sdui.visibility"
    },
    "binding": { "type": "component", "component": "sdui.binding" },
    "validations": { "type": "component", "component": "sdui.validation", "repeatable": true },
    "span": {
      "type": "integer"
    },
    "dynamic": { "type": "component", "component": "sdui.dynamic" }
  }
}
