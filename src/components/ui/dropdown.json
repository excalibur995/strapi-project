{
  "collectionName": "components_ui_dropdowns",
  "info": { "displayName": "Dropdown", "description": "Single-select from static options. type: ui.dropdown" },
  "options": {},
  "attributes": {
    "componentId": { "type": "string" },
    "testId": { "type": "string" },
    "label": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "name": { "type": "string" },
    "placeholder": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "defaultValue": { "type": "string" },
    "searchable": { "type": "boolean", "default": false },
    "required": { "type": "boolean", "default": false },
    "enabled": { "type": "boolean", "default": true },
    "editable": { "type": "boolean", "default": true },
    "visible": { "type": "boolean", "default": true },
    "options": { "type": "component", "repeatable": true, "component": "ui.option", "required": true },
    "conditions": { "type": "json" },
    "span": { "type": "integer" }
