{
  "collectionName": "components_ui_buttons",
  "info": { "displayName": "Button" },
  "options": {},
  "attributes": {
    "componentId": { "type": "string" },
    "testId": { "type": "string" },
    "label": { "type": "string", "required": true, "pluginOptions": { "i18n": { "localized": true } } },
    "variant": { "type": "enumeration", "enum": ["primary", "secondary", "ghost", "danger"], "default": "primary" },
    "guardRules": { "type": "relation", "relation": "manyToMany", "target": "api::rule-set.rule-set" },
    "visibility": { "type": "component", "component": "sdui.visibility" },
    "span": { "type": "integer" }
  }
}
