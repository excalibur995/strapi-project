{
  "collectionName": "components_ui_buttons",
  "info": { "displayName": "Button", "description": "Interactive button. type: ui.button" },
  "options": {},
  "attributes": {
    "componentId": { "type": "string" },
    "testId": { "type": "string" },
    "label": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "name": { "type": "string" },
    "variant": {
      "type": "enumeration",
      "enum": ["primary", "secondary", "ghost", "danger", "promo"],
      "default": "primary"
    },
    "enabled": { "type": "boolean", "default": true },
    "visible": { "type": "boolean", "default": true },
    "action": { "type": "json" },
    "icon": { "type": "json" },
    "placement": { "type": "json" },
    "span": { "type": "integer" }
  }
}
