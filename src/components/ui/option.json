{
  "collectionName": "components_ui_options",
  "info": {
    "displayName": "Option",
    "description": "Single selectable option item. type: ui.option"
  },
  "options": {},
  "attributes": {
    "testId": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "value": {
      "type": "string",
      "required": true
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "media": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "visibility": { "type": "component", "component": "sdui.visibility" },
    "validations": {
      "type": "component",
      "component": "sdui.validation",
      "repeatable": true
    }
  }
}
