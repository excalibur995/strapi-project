{
  "collectionName": "components_ui_progress_bars",
  "info": {
    "displayName": "Progress Bar",
    "description": "Step progress indicator. type: ui.progress-bar"
  },
  "options": {},
  "attributes": {
    "componentId": { "type": "string" },
    "testId": { "type": "string" },
    "name": { "type": "string" },
    "label": { "type": "string", "pluginOptions": { "i18n": { "localized": true } } },
    "defaultValue": { "type": "string" },
    "maxLength": { "type": "string" },
    "required": { "type": "boolean", "default": false },
    "editable": { "type": "boolean", "default": true },
    "prefix": { "type": "string" },
    "suffix": { "type": "string" },
    "toggleField": { "type": "boolean", "default": false },
    "toggleFieldReff": { "type": "string" },
    "toggleFieldCollapse": { "type": "boolean", "default": false },
    "collapsable": { "type": "boolean", "default": false },
    "collapseCondition": { "type": "string" },
    "currentStep": { "type": "integer", "required": true },
    "maxStep": { "type": "integer", "required": true },
    "enabled": { "type": "boolean", "default": true },
    "visible": { "type": "boolean", "default": true },
    "scope": { "type": "enumeration", "enum": ["journeyState", "localState", "serverState"], "default": "journeyState" },
    "visibility": { "type": "component", "component": "sdui.visibility" },
    "validations": { "type": "component", "component": "sdui.validation", "repeatable": true },
    "span": { "type": "integer", "default": 12 },
    "dynamic": { "type": "component", "component": "sdui.dynamic" }
  }
}
